# ── API ──────────────────────────────────────────────────────────────
# Toàn bộ request FE đi qua biến này.
# Dev (Mock API chạy trong chính app này):  http://localhost:3000/api
# Production (backend thật):                https://api.domain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ── Mock API (chỉ server-side) ───────────────────────────────────────
# true: bật Route Handler giả lập API tại /api/*. Production nên để false.
MOCK_API_ENABLED=true
# Độ trễ giả lập mỗi request (ms). Có thể ghi đè bằng header x-mock-delay.
MOCK_API_DELAY_MS=350

# ── Dev tools ────────────────────────────────────────────────────────
# true: hiện thanh công cụ dev (đổi vai trò RBAC, giả lập chậm/lỗi/rỗng). Production phải để false.
NEXT_PUBLIC_DEV_TOOLS=true

# Website công khai
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
# reCAPTCHA v3 (tùy chọn). Để trống = không dùng.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Token cho webhook làm mới nội dung (POST /api/revalidate)
REVALIDATE_SECRET=change-me
